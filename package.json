{
  "name": "@enrichlayer/cli-v3",
  "version": "0.2.0",
  "description": "Command-line client for the Enrich Layer v3 API — person and company profiles, company search and logos, work email search and email validation",
  "type": "module",
  "bin": {
    "enrichlayer-v3": "build/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\" && tsc",
    "typecheck": "tsc --noEmit",
    "update-spec": "node scripts/update-spec.mjs",
    "gen:params": "node scripts/generate-params.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "enrich-layer",
    "enrichment",
    "cli",
    "company-data",
    "person-data",
    "email-validation"
  ],
  "author": "Enrich Layer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enrichlayer/cli.git"
  },
  "bugs": {
    "url": "https://github.com/enrichlayer/cli/issues"
  },
  "homepage": "https://github.com/enrichlayer/cli#readme",
  "dependencies": {
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.3"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
